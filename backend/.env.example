# .env.example — copy to .env on your EC2 instance and fill in all values.
# NEVER commit .env to version control.
#
# How to copy:
#   scp -i your-key.pem backend/.env.example ubuntu@<EC2_IP>:/home/ubuntu/studyroom/.env
# Then edit the .env file on EC2 with your actual values.

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
APP_NAME=StudyRoom
APP_ENV=production
DEBUG=false
# Your Vercel frontend URL. Add multiple as a JSON array:
# ALLOWED_ORIGINS=["https://study.granth.tech","https://study-git-main-yourname.vercel.app"]
ALLOWED_ORIGINS=["https://study.granth.tech"]

# ---------------------------------------------------------------------------
# Database — Neon PostgreSQL
# ---------------------------------------------------------------------------
# Get this from your Neon project dashboard → Connection Details.
# Use the "pooled" connection string for production (uses PgBouncer).
# It looks like: postgresql+asyncpg://user:pass@ep-xxx.us-east-1.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql+asyncpg://<user>:<password>@<host>.neon.tech/<dbname>?sslmode=require

# Connection pool settings — sized for t3.micro (1 vCPU, 1 GB RAM).
# Neon's free tier allows max 10 connections; pooled connection is unlimited.
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800
DATABASE_POOL_PRE_PING=true

# ---------------------------------------------------------------------------
# Redis — Upstash Redis
# ---------------------------------------------------------------------------
# Get this from your Upstash console → Connect → .env tab.
# Use the rediss:// (TLS) URL — Upstash requires TLS for all connections.
# It looks like: rediss://default:<password>@<endpoint>.upstash.io:6379
REDIS_URL=rediss://default:<password>@<endpoint>.upstash.io:6379

# Connection settings for Upstash (low latency over TLS, fewer connections needed)
REDIS_MAX_CONNECTIONS=10
REDIS_SOCKET_TIMEOUT=5.0
REDIS_SOCKET_CONNECT_TIMEOUT=5.0
REDIS_RETRY_ON_TIMEOUT=true
REDIS_DECODE_RESPONSES=true

# ---------------------------------------------------------------------------
# JWT
# ---------------------------------------------------------------------------
# Generate a strong secret: openssl rand -base64 64
JWT_SECRET_KEY=changeme-generate-with-openssl-rand-base64-64
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------------------------------------------------------------------------
# WebSocket
# ---------------------------------------------------------------------------
WS_HEARTBEAT_INTERVAL=30

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=60

# ---------------------------------------------------------------------------
# Docker / ECR
# ---------------------------------------------------------------------------
# Set by GitHub Actions automatically. For a manual first deploy, set it here.
# Format: <aws_account_id>.dkr.ecr.<region>.amazonaws.com/studyroom-api:latest
ECR_IMAGE=<aws_account_id>.dkr.ecr.us-east-1.amazonaws.com/studyroom-api:latest
