# .env.example — copy to .env and fill in all values before deploying
# Never commit .env to version control.

# App
APP_NAME=StudyRoom
APP_ENV=production
DEBUG=false
ALLOWED_ORIGINS=["https://your-frontend.vercel.app"]

# PostgreSQL — used for docker-compose variable interpolation
# DATABASE_URL is constructed from these by docker-compose.yml
POSTGRES_DB=studyroom
POSTGRES_USER=studyroom
POSTGRES_PASSWORD=changeme-generate-with-openssl-rand-base64-32

# Redis
# REDIS_URL is constructed from this by docker-compose.yml
REDIS_PASSWORD=changeme-generate-with-openssl-rand-base64-32

# JWT
JWT_SECRET_KEY=changeme-generate-with-openssl-rand-base64-64
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# WebSocket
WS_HEARTBEAT_INTERVAL=30

# Rate limiting
RATE_LIMIT_PER_MINUTE=60

# Connection pool sizing for t3.micro (1 GB RAM, 2 vCPU)
# Reduce DATABASE_POOL_SIZE to 3 and REDIS_MAX_CONNECTIONS to 5 if swapping
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
REDIS_MAX_CONNECTIONS=10

# ECR image URI — set by GitHub Actions, or manually before first deploy
ECR_IMAGE=<aws_account_id>.dkr.ecr.us-east-1.amazonaws.com/studyroom-api:latest

# Optional: S3 bucket for PostgreSQL backups (used by scripts/backup-db.sh)
# S3_BUCKET=your-backup-bucket-name
